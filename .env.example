# =================================================================
# NER-SAFE Environment Configuration (SIH Production & Demo Mode)
# =================================================================

# Server Settings
PORT=5000
NODE_ENV=development
AUTH_SECRET=ner_safe_jwt_secret_dev_key_change_in_production
CORS_ORIGIN=http://localhost:5173

# Simulation & Demo Mode Flag (Set true to enable rich seed simulation across 8 NER states)
DEMO_MODE=true

# Database (Leave empty for fast in-memory SQLite persistent fallback)
DATABASE_URL=

# External API Integrations (Optional in Demo Mode - automated fallbacks provided)
# 1. Open-Meteo / IMD Weather API
WEATHER_API_KEY=
IMD_API_KEY=

# 2. ISRO Bhuvan / Sentinel / Copernicus Satellite Observations
SATELLITE_API_KEY=
BHUVAN_API_KEY=

# 3. Emergency SMS & Email Gateways (Twilio, SendGrid, NIC SMS Gateway)
SMS_API_KEY=
SMS_SENDER_ID=NERSAFE
EMAIL_API_KEY=
EMAIL_FROM=alerts@ner-safe.gov.in

# 4. GIS & Map Tile Services (Defaults to OpenStreetMap / CartoDB free tiles)
MAP_API_KEY=
MAPBOX_TOKEN=
